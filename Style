:root{
  --paper: #EFE8D8;
  --surface: #FAF7EF;
  --ink: #1E2A2E;
  --ink-soft: #48555A;
  --line: #D9D0B4;
  --gold: #A8792B;
  --gold-soft: #C79A4B;
  --teal: #355E56;
  --teal-soft: #E2E9E4;
  --sidebar-bg: #1E2A2E;
  --sidebar-text: #D9DEDA;
  --sidebar-text-dim: #8A9A96;
  --radius-card: 3px;
  --serif: "Fraunces", Georgia, serif;
  --sans: "IBM Plex Sans", -apple-system, sans-serif;
  --mono: "IBM Plex Mono", monospace;
}

*{box-sizing:border-box;}
html,body{margin:0;padding:0;}
body{
  background:var(--paper);
  color:var(--ink);
  font-family:var(--sans);
  line-height:1.55;
  -webkit-font-smoothing:antialiased;
}

/* ---------- Header ---------- */
.site-header{
  background:var(--sidebar-bg);
  color:var(--sidebar-text);
  border-bottom:3px solid var(--gold);
}
.header-inner{
  max-width:1180px;
  margin:0 auto;
  padding:22px 28px;
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:20px;
  flex-wrap:wrap;
}
.brand{display:flex; align-items:center; gap:16px;}
.brand-mark{
  font-family:var(--serif);
  font-weight:700;
  font-size:1.6rem;
  background:var(--gold);
  color:var(--sidebar-bg);
  width:48px; height:48px;
  border-radius:50%;
  display:flex; align-items:center; justify-content:center;
  flex-shrink:0;
}
.brand-text h1{
  font-family:var(--serif);
  font-size:1.5rem;
  font-weight:600;
  margin:0;
  letter-spacing:0.01em;
}
.brand-text p{
  margin:2px 0 0;
  font-size:0.85rem;
  color:var(--sidebar-text-dim);
}
.header-goal{
  text-align:right;
  border-left:1px solid rgba(255,255,255,0.15);
  padding-left:20px;
}
.goal-label{
  display:block;
  font-size:0.75rem;
  color:var(--sidebar-text-dim);
}
.goal-value{
  display:block;
  font-family:var(--serif);
  font-size:1.15rem;
  color:var(--gold-soft);
  font-weight:600;
}

/* ---------- Layout ---------- */
.layout{
  max-width:1180px;
  margin:0 auto;
  display:grid;
  grid-template-columns:280px 1fr;
  gap:0;
  min-height:70vh;
}
.sidebar{
  background:var(--sidebar-bg);
  color:var(--sidebar-text);
  padding:24px 18px 40px;
}
.search-box{margin-bottom:18px;}
#search-input{
  width:100%;
  padding:10px 12px;
  border-radius:var(--radius-card);
  border:1px solid rgba(255,255,255,0.2);
  background:rgba(255,255,255,0.06);
  color:var(--sidebar-text);
  font-family:var(--sans);
  font-size:0.9rem;
}
#search-input::placeholder{color:var(--sidebar-text-dim);}
#search-input:focus{outline:2px solid var(--gold-soft); outline-offset:1px;}

.nav-semester-label{
  font-family:var(--serif);
  font-size:0.95rem;
  color:var(--sidebar-text-dim);
  margin:22px 0 8px;
  padding-bottom:6px;
  border-bottom:1px solid rgba(255,255,255,0.12);
}
.nav-semester-label:first-child{margin-top:0;}

.nav-item{
  display:flex;
  align-items:baseline;
  gap:8px;
  width:100%;
  text-align:left;
  background:none;
  border:none;
  color:var(--sidebar-text);
  padding:8px 8px;
  border-radius:var(--radius-card);
  cursor:pointer;
  font-family:var(--sans);
  font-size:0.88rem;
}
.nav-item:hover{background:rgba(255,255,255,0.08);}
.nav-item.active{
  background:var(--gold);
  color:var(--sidebar-bg);
  font-weight:600;
}
.nav-item .code{
  font-family:var(--mono);
  font-size:0.72rem;
  color:var(--sidebar-text-dim);
  flex-shrink:0;
}
.nav-item.active .code{color:var(--sidebar-bg); opacity:0.7;}

.nav-optional-tag{
  font-size:0.68rem;
  color:var(--gold-soft);
  margin-left:auto;
  flex-shrink:0;
}
.nav-item.active .nav-optional-tag{color:var(--sidebar-bg);}

/* ---------- Content ---------- */
.content{
  background:var(--surface);
  padding:36px 44px;
}
.ue-header{
  border-bottom:2px solid var(--line);
  padding-bottom:16px;
  margin-bottom:24px;
  display:flex;
  align-items:baseline;
  gap:14px;
  flex-wrap:wrap;
}
.ue-code{
  font-family:var(--mono);
  font-size:0.85rem;
  color:var(--gold);
  border:1px solid var(--gold);
  padding:2px 8px;
  border-radius:var(--radius-card);
}
.ue-title{
  font-family:var(--serif);
  font-size:1.7rem;
  font-weight:600;
  margin:0;
  color:var(--ink);
}
.ue-matieres{
  font-size:0.9rem;
  color:var(--ink-soft);
  margin:6px 0 0;
}

.ue-columns{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:32px;
}
@media (max-width:760px){
  .ue-columns{grid-template-columns:1fr;}
}

.ue-block h3{
  font-family:var(--serif);
  font-size:1.1rem;
  font-weight:600;
  color:var(--teal);
  margin:0 0 12px;
}
.ue-block ul{
  margin:0;
  padding-left:0;
  list-style:none;
}
.ue-block li{
  padding:9px 0 9px 22px;
  position:relative;
  border-bottom:1px solid var(--line);
  font-size:0.93rem;
  color:var(--ink);
}
.ue-block li:last-child{border-bottom:none;}
.ue-block li::before{
  content:"";
  position:absolute;
  left:2px;
  top:16px;
  width:6px;
  height:6px;
  border-radius:50%;
  background:var(--gold-soft);
}
.ressources-block li::before{background:var(--teal);}

.option-card{
  border:1px solid var(--line);
  border-radius:var(--radius-card);
  padding:18px 20px;
  margin-top:14px;
  background:#fff;
}
.option-card h4{
  font-family:var(--serif);
  font-size:1.05rem;
  margin:0 0 10px;
}
.optional-wrap{margin-top:34px;}
.optional-wrap > p.optional-label{
  font-family:var(--serif);
  font-size:1.05rem;
  color:var(--ink-soft);
  margin-bottom:4px;
}

/* ---------- Overview / home ---------- */
.overview-grid{
  display:grid;
  grid-template-columns:repeat(auto-fill, minmax(240px,1fr));
  gap:14px;
  margin-top:8px;
}
.overview-card{
  border:1px solid var(--line);
  background:#fff;
  border-radius:var(--radius-card);
  padding:16px 18px;
  cursor:pointer;
  text-align:left;
  font-family:var(--sans);
}
.overview-card:hover{border-color:var(--gold); transform:translateY(-1px);}
.overview-card .code{font-family:var(--mono); font-size:0.75rem; color:var(--gold);}
.overview-card h4{font-family:var(--serif); margin:6px 0 0; font-size:1.05rem;}

.strategie-list{
  margin-top:10px;
  padding-left:0;
  list-style:none;
  counter-reset:strat;
}
.strategie-list li{
  counter-increment:strat;
  padding:10px 0 10px 34px;
  position:relative;
  border-bottom:1px solid var(--line);
  font-size:0.93rem;
}
.strategie-list li::before{
  content:counter(strat);
  position:absolute;
  left:0;
  top:8px;
  width:22px;
  height:22px;
  border-radius:50%;
  background:var(--teal);
  color:#fff;
  font-family:var(--mono);
  font-size:0.72rem;
  display:flex;
  align-items:center;
  justify-content:center;
}
.strategie-list li:last-child{border-bottom:none;}

.no-results{color:var(--ink-soft); font-style:italic; padding:20px 0;}

/* ---------- Footer ---------- */
.site-footer{
  max-width:1180px;
  margin:0 auto;
  padding:24px 28px 50px;
  color:var(--ink-soft);
  font-size:0.82rem;
}
.footer-source{margin-top:4px;}

/* ---------- Mobile ---------- */
@media (max-width:820px){
  .layout{grid-template-columns:1fr;}
  .sidebar{
    display:flex;
    flex-direction:column;
    max-height:none;
  }
  .content{padding:26px 20px;}
  .header-goal{text-align:left; border-left:none; padding-left:0;}
}
